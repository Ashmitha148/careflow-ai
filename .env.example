# Server Port Configuration
PORT=8080

# Database Configuration (PostgreSQL with pgvector)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/careflow_db
SPRING_DATASOURCE_USERNAME=careflow_user
SPRING_DATASOURCE_PASSWORD=careflow_password

# JWT Authentication
# Generate your own secret, never commit a real one:
#   openssl rand -hex 32   (64 hex characters)
JWT_SECRET=replace_with_your_own_random_64_hex_char_secret_here
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Gemini AI API Key (used by CopilotController for timeline Q&A, summaries, plain-language notes)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api